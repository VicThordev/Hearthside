# Server-only values. Copy to .env locally; never commit real values.
NODE_ENV="development"
PORT="4000"
# Set to the number of reverse proxies/load balancers in front of the API (0 when exposed directly).
TRUST_PROXY_HOPS="0"
APP_URL="http://localhost:3000"
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVER_ONLY_SERVICE_ROLE_KEY"
SUPABASE_DOCUMENTS_BUCKET="care-documents"

# Browser-visible configuration. The Supabase anon key is designed for the browser;
# protect data with RLS and never prefix the service-role key with VITE_.
# Leave empty in production builds that are served by the API itself (the Docker image does this).
VITE_API_URL="http://localhost:4000"
VITE_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_BROWSER_ANON_KEY"
# Comma-separated social sign-in buttons to show in live mode, e.g. "google,apple".
# List a provider only after enabling it in Supabase Auth.
VITE_OAUTH_PROVIDERS=""

# Keep this as demo until all release gates are completed. A live mode intentionally
# starts with empty data where a real API integration is not available.
VITE_RELEASE_MODE="demo"
